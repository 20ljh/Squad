{
  "name": "squad-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f ../../docker-compose.yml up -d db",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prisma/client": "6.19.3",
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "wanted-sans": "1.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.33",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.7.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
