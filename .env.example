# 실제 값은 apps/web/.env 에 넣고 커밋하지 마세요. 배포 VM의 값은 infra/env.prod.example 참고
DATABASE_URL=postgresql://squad:squad@localhost:5432/squad
# 서비스 주소 (구글·Notion 콜백 주소를 만들 때 씀). 배포에서는 https 주소
APP_URL=http://localhost:3000

# 초대 코드 HMAC 등에 쓰는 서버 비밀값 (32자 이상 무작위)
AUTH_SECRET=
# Notion 토큰 같은 비밀값 암호화 키 (AES-256-GCM, base64 32바이트)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# 구글 로그인 (Google Cloud 콘솔 → OAuth 클라이언트 ID, 웹 애플리케이션)
# 승인된 리디렉션 URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion 공개 연동(OAuth) (notion.so/profile/integrations → Public)
# 리디렉션 URI: {APP_URL}/api/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# 회의 요약 LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# STT 워커의 화자 분리(pyannote) 모델 다운로드용 Hugging Face 토큰 (read 권한)
HF_TOKEN=
# STT 워커가 웹 API(/api/worker/*)에 붙을 때 쓰는 비밀 키 (웹과 워커에 같은 값, 32자 이상 무작위)
WORKER_TOKEN=
