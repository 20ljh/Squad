# 실제 값은 .env 에 넣고 커밋하지 마세요. 클라우드 세션에서는 Claude Code 클라우드 환경(Environment)의 환경 변수로 넣습니다.
DATABASE_URL=postgresql://squad:squad@localhost:5432/squad
NOTION_TOKEN=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
STT_WORKER_URL=http://localhost:8000
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
OBJECT_STORAGE_ENDPOINT=
# STT 워커의 화자 분리(pyannote) 모델 다운로드용 Hugging Face 토큰 (read 권한)
HF_TOKEN=
# STT 워커가 웹 API(/api/worker/*)에 붙을 때 쓰는 비밀 키 (웹과 워커에 같은 값, 32자 이상 무작위)
WORKER_TOKEN=
