# VM의 /opt/squad/.env 로 복사해서 값을 채움 (이 파일 자체에는 비밀값을 넣지 않음)
DOMAIN=squad-dku.eastasia.cloudapp.azure.com
POSTGRES_PASSWORD=

# 웹 앱이 읽는 값 (apps/web/.env 와 같은 이름)
AUTH_SECRET=
ENCRYPTION_KEY=
WORKER_TOKEN=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
